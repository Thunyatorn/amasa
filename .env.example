# Copy the web variables to apps/web/.env.local and the payments variables to
# services/payments/.env. Never commit the real files. Never prefix with NEXT_PUBLIC_.
# VERIFIER_* keys are written by `pnpm keys` (§10.1); do not paste them by hand.

# ---- apps/web (apps/web/.env.local) ----
# anthropic or openai
MODEL_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# MODEL_PROVIDER=ollama runs a local model through Ollama (no key). Default below.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Pick current model ids from the provider's docs (§19)
MODEL_PLANNER=
# Empty MODEL_READER uses MODEL_PLANNER for the reader too.
MODEL_READER=
SESSION_SECRET=
VERIFIER_PRIVATE_KEY_B64=
PAYMENTS_URL=http://127.0.0.1:4100
STORE_BASE_URL=http://127.0.0.1:3000/api/store
DATABASE_PATH=
# Defaults when empty: MAX_STEPS=10 planner steps, RUN_TOKEN_BUDGET=150000 tokens per run.
MAX_STEPS=
RUN_TOKEN_BUDGET=
DEMO_REPLAY=false
TAP_ENABLED=false
TAP_AGENT_PRIVATE_KEY_B64=
TAP_AGENT_PUBLIC_KEY_B64=

# ---- services/payments (services/payments/.env) ----
VISA_ACCEPTANCE_MERCHANT_ID=
VISA_ACCEPTANCE_API_KEY_ID=
VISA_ACCEPTANCE_SECRET_KEY=
VISA_ACCEPTANCE_ENVIRONMENT=SANDBOX
VERIFIER_PUBLIC_KEY_B64=
PAYMENTS_DB_PATH=
PAYMENTS_MAX_DAILY_CENTS=
PORT=4100

# Public deployment only: one shared password for the whole site (HTTP Basic). Unset locally = no gate.
# On Fly the site refuses to serve without it.
DEMO_PASSWORD=
