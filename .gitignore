# Secrets: never commit env files (the template is the only exception)
.env*
!.env.example

# SQLite databases (and WAL/SHM side files)
*.db
*.db-*

# Model replay cache (§17.4)
data/replay/

node_modules/
.next/
next-env.d.ts
*.tsbuildinfo
dist/
coverage/
.DS_Store

# Standalone celebrity asset tooling
scripts/celebrities/.venv/
scripts/celebrities/__pycache__/

# Celebrity photos stay local until image rights are cleared (the app serves them from disk)
data/celebrities/*.jpg
