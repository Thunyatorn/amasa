// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`contract screen > renders without crashing and has labels for every editable control 1`] = `"<main class="screen"><p class="eyebrow">01 / Set the boundaries</p><h1 tabindex="-1">Review your contract</h1><p class="subtitle">Your goal, translated into clear shopping rules. Edit any detail before Amasa starts looking.</p><p>A pop musician</p><form noValidate="" aria-busy="false"><fieldset><legend>Shopping requirements</legend><div class="field-grid"><div><label for="budget">Budget in VU</label><div class="money-input"><span aria-hidden="true">VU</span><input id="budget" aria-invalid="false" inputMode="decimal" required="" aria-describedby="budget-help contract-status" value="250.00"/></div><p class="hint" id="budget-help">Total including tax. Maximum 5,000.00 VU (1 VU = $1.00 in this demo).</p></div><div><label for="quantity">Quantity</label><input id="quantity" aria-invalid="false" aria-describedby="contract-status" type="number" min="1" max="10" step="1" required="" value="1"/></div><div><label for="returns">Minimum refund days</label><input id="returns" aria-invalid="false" aria-describedby="contract-status" type="number" min="0" max="365" step="1" required="" value="30"/></div><div><label for="deadline">Deadline (optional)</label><input id="deadline" aria-invalid="false" aria-describedby="contract-status" type="date" min="2026-10-17" value=""/></div><div><label for="choice">Genre (optional)</label><select id="choice" aria-invalid="false" aria-describedby="contract-status"><option value="">Any genre</option><option value="pop" selected="">Pop</option><option value="rock">Rock</option><option value="r&amp;b">R&amp;B</option><option value="soul">Soul</option><option value="hip-hop">Hip-hop</option><option value="country">Country</option><option value="latin">Latin</option><option value="electronic">Electronic</option></select></div></div><section aria-labelledby="other-rules"><h2 id="other-rules">Other requirements</h2><ul class="rules"><li class="chip"><label for="rule-0">brand is</label><input id="rule-0" aria-invalid="false" aria-describedby="contract-status" maxLength="40" value="Example"/><button class="secondary" type="button" aria-label="Remove brand requirement">Remove</button></li></ul></section></fieldset><p class="hint">Your edits stay here until you choose Looks right.</p><button type="submit">Looks right</button></form><p id="contract-status" role="status" aria-live="polite"></p><a href="/">Back to home</a></main>"`;

exports[`goal screen > renders a labelled goal input, three example buttons and a stable initial snapshot 1`] = `"<main class="screen home-screen"><h1 class="visually-hidden">Amasa: buy celebrities, priced in VU</h1><div class="goal-layout"><div class="goal-compose"><form noValidate="" aria-busy="false"><label for="goal">What would you like to shop for?</label><input id="goal" placeholder="Tell me what you need, and what matters to you…" minLength="3" maxLength="300" required="" aria-describedby="goal-count goal-status" aria-invalid="false" name="goal" value=""/><p id="goal-count" class="hint">300 characters remaining</p><button type="submit">Next</button><p id="goal-status" role="status" aria-live="polite"></p></form><section aria-labelledby="examples-heading"><h2 id="examples-heading">Example goals</h2><ul class="examples"><li><button class="secondary" type="button"><span class="example-number" aria-hidden="true">01</span><span>An Oscar-winning actor, under 300 VU, must be refundable</span><span aria-hidden="true">↗</span></button></li><li><button class="secondary" type="button"><span class="example-number" aria-hidden="true">02</span><span>A pop musician, under 250 VU</span><span aria-hidden="true">↗</span></button></li><li><button class="secondary" type="button"><span class="example-number" aria-hidden="true">03</span><span>A tennis player, under 300 VU</span><span aria-hidden="true">↗</span></button></li></ul></section></div><aside class="goal-guide"><ol><li><strong>Make it yours</strong><p>Review and edit your budget and requirements before the search.</p></li><li><strong>See the trade-offs</strong><p>Compare full costs, refund windows and ratings, with the reasons behind each option.</p></li><li><strong>Stay in control</strong><p>Review the checks. Enter your card only on Visa&#x27;s hosted payment page.</p></li></ol></aside></div><p><a href="/settings">Settings: how much Amasa does for you, your profile and your data</a></p></main>"`;
