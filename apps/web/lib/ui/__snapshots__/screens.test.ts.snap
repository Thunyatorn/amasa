// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`contract screen > renders without crashing and has labels for every editable control 1`] = `"<main class="screen"><h1 tabindex="-1">Review your contract</h1><p>Wide shoes</p><form noValidate="" aria-busy="false"><fieldset><legend>Shopping requirements</legend><div class="field-grid"><div><label for="budget">Budget in dollars</label><div class="money-input"><span aria-hidden="true">$</span><input id="budget" aria-invalid="false" inputMode="decimal" required="" aria-describedby="budget-help contract-status" value="140.00"/></div><p class="hint" id="budget-help">Total including tax and shipping. Maximum $5,000.00.</p></div><div><label for="quantity">Quantity</label><input id="quantity" aria-invalid="false" aria-describedby="contract-status" type="number" min="1" max="10" step="1" required="" value="1"/></div><div><label for="returns">Minimum return days</label><input id="returns" aria-invalid="false" aria-describedby="contract-status" type="number" min="0" max="365" step="1" required="" value="30"/></div><div><label for="deadline">Deadline (optional)</label><input id="deadline" aria-invalid="false" aria-describedby="contract-status" type="date" min="2026-10-17" value=""/></div><div><label for="width">Width (optional)</label><select id="width" aria-invalid="false" aria-describedby="contract-status"><option value="">No width requirement</option><option value="wide" selected="">Wide</option><option value="standard">Standard</option><option value="narrow">Narrow</option></select></div><div><label for="size">Size (optional)</label><input id="size" aria-invalid="false" aria-describedby="contract-status" inputMode="decimal" maxLength="40" value="10.5"/></div></div><section aria-labelledby="other-rules"><h2 id="other-rules">Other requirements</h2><ul class="rules"><li class="chip"><label for="rule-0">brand is</label><input id="rule-0" aria-invalid="false" aria-describedby="contract-status" maxLength="40" value="Example"/><button class="secondary" type="button" aria-label="Remove brand requirement">Remove</button></li></ul></section></fieldset><p class="hint">Your edits stay here until you choose Looks right.</p><button type="submit">Looks right</button></form><p id="contract-status" role="status" aria-live="polite"></p><a href="/">Back to home</a></main>"`;

exports[`goal screen > renders a labelled goal input, three example buttons and a stable initial snapshot 1`] = `"<main class="screen"><header><h1>Amasa</h1><p class="subtitle">A personal shopping agent that never pays without your OK.</p></header><p>I shop demo-store and never pay without your OK</p><section aria-labelledby="examples-heading"><h2 id="examples-heading">Example goals</h2><ul class="examples"><li><button class="secondary" type="button">Wide running shoes for a half marathon, size 10.5, under $140, must be returnable</button></li><li><button class="secondary" type="button">Groceries for the week, under $80</button></li><li><button class="secondary" type="button">Household cleaning supplies, under $40</button></li></ul></section><form noValidate="" aria-busy="false"><label for="goal">What would you like to shop for?</label><input id="goal" minLength="3" maxLength="300" required="" aria-describedby="goal-count goal-status" aria-invalid="false" name="goal" value=""/><p id="goal-count" class="hint">300 characters remaining</p><button type="submit">Next</button><p id="goal-status" role="status" aria-live="polite"></p></form></main>"`;
